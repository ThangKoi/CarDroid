+/** Width of the dark gap between the two panels. Long-pressing it opens the app chooser. */
+private val PANEL_GAP = 28.dp
+/** Corner radius of each panel; 0.dp = square, edge to edge. */
+private val PANEL_CORNER = 0.dp
+
+/**
+ * Apps for the left/right panels. An explicit pick (long-press the gap) wins. Otherwise the left panel defaults to a navigation app
+ * (label contains "vietmap", else Google Maps) and the right panel to a patched YouTube (label contains "morphe"), else Google Maps / YouTube.
+ * The two panels never default to the same app.
+ */
+private fun resolvePanelApps(apps: List<CarApp>, selected: List<String>): List<CarApp?> {
+    val maps = "com.google.android.apps.maps"
+    val youtube = "com.google.android.youtube"
+    fun byLabel(list: List<CarApp>, word: String): CarApp? = list.firstOrNull { it.label.contains(word, ignoreCase = true) }
+    fun byPackage(list: List<CarApp>, pkg: String): CarApp? = list.firstOrNull { it.packageName == pkg }
+    val chosenLeft = apps.firstOrNull { it.target == selected.getOrNull(0) }
+    val chosenRight = apps.firstOrNull { it.target == selected.getOrNull(1) }
+    val left = chosenLeft ?: apps.filter { it.packageName != chosenRight?.packageName }.let { byLabel(it, "vietmap") ?: byPackage(it, maps) }
+    val right = chosenRight ?: apps.filter { it.packageName != left?.packageName }.let { byLabel(it, "morphe") ?: byPackage(it, maps) ?: byPackage(it, youtube) }
+    return listOf(left, right)
+}
